# Copy this file to .env, then set one provider API key.

# ============================================================
# 数据库
# ============================================================
# 数据库连接串（可选；默认本地 5432 的 enterprise_kb）。外置数据库时取消注释并填写。
# DATABASE_URL=postgresql+psycopg://enterprise_kb:enterprise_kb@localhost:5432/enterprise_kb

QWEN_API_KEY=
DEEPSEEK_API_KEY=

# ============================================================
# 认证与授权
# ============================================================
# JWT 签名密钥：生产环境必须设置随机长字符串；开发模式可留空（使用内置开发密钥）。
AUTH_JWT_SECRET=
# 访问令牌有效期（分钟）
AUTH_TOKEN_TTL_MINUTES=480
# 开发模式登录（POST /auth/login 按用户名签发令牌）：本地联调用 true，生产必须 false
AUTH_DEV_MODE=true

# SSO（预留，暂未接入）：设置 SSO_PROVIDER=oidc 并填 OIDC_* 后启用
SSO_PROVIDER=
OIDC_DISCOVERY_URL=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# 跨域来源（开发模式缺省为 *；逗号分隔配置具体域名）
CORS_ORIGINS=
# 上传大小上限（字节，默认 100MB）
MAX_UPLOAD_BYTES=104857600
# 单文档解析内存上限（字节，默认 512MB）：限制读入文件大小与 ZIP 解压后体积，防 zip bomb
MAX_PARSE_BYTES=536870912
# 审计日志文件（留空则仅输出到 stdout）
AUDIT_LOG_FILE=

# ============================================================
# 会话持久化（历史会话 / 归档 / 保留）
# ============================================================
# 活跃会话超过该天数未更新 → 自动归档（软归档，可恢复）；留空或 ≤0 表示关闭
CONVERSATION_ARCHIVE_DAYS=
# 已归档会话超过该天数 → 永久删除（连同消息）；留空或 ≤0 表示关闭
CONVERSATION_RETENTION_DAYS=
# 审计日志保留天数，超过即删除；留空或 ≤0 表示永久保留（默认）
AUDIT_RETENTION_DAYS=

# ============================================================
# 检索与重排
# ============================================================
# BGE Rerank 本地模型路径（覆盖 config/models.yaml 的 retrieval.rerank.model）。
# 留空时使用 models.yaml 的值（默认 HuggingFace 模型 ID BAAI/bge-reranker-v2-m3，首次使用会自动下载）。
# 已本地下载时建议指向模型目录，例如 Windows: E:/EnterpriseKB/models/bge-reranker-v2-m3
RERANK_MODEL_PATH=
# 是否启用本地 BGE Rerank（覆盖 config/models.yaml 的 retrieval.rerank.enabled）。
# 留空用配置文件值；低内存环境建议设为 false，退回混合检索（dense+BM25+RRF）。
RERANK_ENABLED=
