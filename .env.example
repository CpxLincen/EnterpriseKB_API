# Copy this file to .env, then set one provider API key.
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# ============================================================
# 认证与授权
# ============================================================
# JWT 签名密钥：生产环境必须设置随机长字符串；开发模式可留空（使用内置开发密钥）。
AUTH_JWT_SECRET=
# 访问令牌有效期（分钟）
AUTH_TOKEN_TTL_MINUTES=480
# 开发模式登录（POST /auth/login 按用户名签发令牌）：本地联调用 true，生产必须 false
AUTH_DEV_MODE=true

# SSO（预留，暂未接入）：设置 SSO_PROVIDER=oidc 并填 OIDC_* 后启用
SSO_PROVIDER=
OIDC_DISCOVERY_URL=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# 跨域来源（开发模式缺省为 *；逗号分隔配置具体域名）
CORS_ORIGINS=
# 上传大小上限（字节，默认 100MB）
MAX_UPLOAD_BYTES=104857600
# 审计日志文件（留空则仅输出到 stdout）
AUDIT_LOG_FILE=
