# ============================================================
# 部署环境变量模板：复制为 .env 后填写（与 docker-compose.deploy.yml 同目录）
# ============================================================

# Qwen：用于 Embedding（必填）+ 默认聊天模型（必填）
QWEN_API_KEY=sk-你的千问密钥

# DeepSeek：仅当把 config/models.yaml 的 active_provider 改为 deepseek 时需要（可选）
DEEPSEEK_API_KEY=

# 数据库密码（可选，默认 enterprise_kb）
POSTGRES_PASSWORD=enterprise_kb

# 前端对外访问端口（可选，默认 8080）
WEB_PORT=8080

# ============================================================
# 认证与授权
# ============================================================
# JWT 签名密钥（生产必填，随机长字符串）
AUTH_JWT_SECRET=
# 访问令牌有效期（分钟）
AUTH_TOKEN_TTL_MINUTES=480
# 生产环境必须关闭开发模式登录
AUTH_DEV_MODE=false

# SSO（预留，暂未接入）：设置 SSO_PROVIDER=oidc 并填 OIDC_* 后启用
SSO_PROVIDER=
OIDC_DISCOVERY_URL=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# 跨域来源（生产同源部署通常留空即可；跨域时用逗号分隔，如 https://kb.example.com）
CORS_ORIGINS=
# 上传大小上限（字节，默认 100MB）
MAX_UPLOAD_BYTES=104857600
# 单文档解析内存上限（字节，默认 512MB）：限制读入文件大小与 ZIP 解压后体积，防 zip bomb
MAX_PARSE_BYTES=536870912
# 审计日志文件（留空则仅输出到 stdout）
AUDIT_LOG_FILE=
