# ============================================================
# 部署环境变量模板：复制为 .env 后填写（与 docker-compose.deploy.yml 同目录）
# ============================================================

# Qwen：用于 Embedding（必填）+ 默认聊天模型（必填）
QWEN_API_KEY=sk-你的千问密钥

# DeepSeek：仅当把 config/models.yaml 的 active_provider 改为 deepseek 时需要（可选）
DEEPSEEK_API_KEY=

# 数据库密码（可选，默认 enterprise_kb）
POSTGRES_PASSWORD=enterprise_kb
# 数据库连接串：默认由 compose 按上方 POSTGRES_PASSWORD 自动拼接、指向 db 服务；
# 如需连接外部 PostgreSQL，请修改 docker-compose.deploy.yml 的 backend DATABASE_URL。

# 前端对外访问端口（可选，默认 8080）
WEB_PORT=8080
# 是否在镜像内安装 Rerank 重依赖（torch，约 1.5GB+；默认 true）。
# 低内存/低配服务器（如 2G 内存）建议设为 false，配合 RERANK_ENABLED=false 跳过本地重排。
INSTALL_RERANK=true
# 是否在镜像内安装 OCR 可选重依赖（rapidocr-onnxruntime + opencv-python-headless；默认 false）。
# 需要扫描 PDF OCR 时设为 true；会增大镜像，但无需 X11/GL 系统库。
INSTALL_OCR=false

# ============================================================
# 认证与授权
# ============================================================
# JWT 签名密钥（生产必填，随机长字符串）
AUTH_JWT_SECRET=
# 访问令牌有效期（分钟）
AUTH_TOKEN_TTL_MINUTES=480
# 生产环境必须关闭开发模式登录
AUTH_DEV_MODE=false

# SSO（预留，暂未接入）：设置 SSO_PROVIDER=oidc 并填 OIDC_* 后启用
SSO_PROVIDER=
OIDC_DISCOVERY_URL=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# 跨域来源（生产同源部署通常留空即可；跨域时用逗号分隔，如 https://kb.example.com）
CORS_ORIGINS=
# 上传大小上限（字节，默认 100MB）
MAX_UPLOAD_BYTES=104857600
# 单文档解析内存上限（字节，默认 512MB）：限制读入文件大小与 ZIP 解压后体积，防 zip bomb
MAX_PARSE_BYTES=536870912
# 审计日志文件（留空则仅输出到 stdout）
AUDIT_LOG_FILE=

# ============================================================
# 会话持久化（历史会话 / 归档 / 保留）
# ============================================================
# 活跃会话超过该天数未更新 → 自动归档（软归档，可恢复）；留空或 ≤0 表示关闭
CONVERSATION_ARCHIVE_DAYS=
# 已归档会话超过该天数 → 永久删除（连同消息）；留空或 ≤0 表示关闭
CONVERSATION_RETENTION_DAYS=
# 审计日志保留天数，超过即删除；留空或 ≤0 表示永久保留（默认）
AUDIT_RETENTION_DAYS=

# BGE Rerank 本地模型路径（覆盖 config/models.yaml 的 retrieval.rerank.model）。
# 生产建议把已下载的模型挂载进容器后设为容器内路径，例如 /models/bge-reranker-v2-m3；
# 留空则使用默认模型 ID（首次使用会尝试自动下载，建议配置内网镜像源）。
# 模型缺失时后端会自动降级为混合检索（dense+BM25+RRF），不会导致问答失败。
RERANK_MODEL_PATH=
# 是否启用本地 BGE Rerank（覆盖 config/models.yaml 的 retrieval.rerank.enabled）。
# 留空用配置文件值；低配服务器（内存 <8G）建议设为 false，退回混合检索（dense+BM25+RRF）。
RERANK_ENABLED=
